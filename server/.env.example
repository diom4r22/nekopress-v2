# NekoPress v2 — Server Configuration
PORT=3001

# Gemini AI API Key (Google AI Studio: https://aistudio.google.com/app/apikey)
# El motor editorial utiliza modelos como gemini-3.8-flash y gemini-2.5-flash.
# Cuenta con protección automática de cuota (HTTP 429) y conmutación a motor heurístico local sin latencia.
GEMINI_API_KEY=

# xAI Grok API Key (Opcional, https://console.x.ai)
# Si se provee, permite utilizar Grok-2 para la curaduría y auditoría de primicias de Radar X.
GROK_API_KEY=

# X / Twitter API v2 Bearer Token (Opcional, https://developer.x.com)
# Si no está configurada o se agotan los créditos (HTTP 402), el radar opera automáticamente
# en modo de alta disponibilidad con fuentes verificadas.
X_BEARER_TOKEN=

# Optional: bearer token for administrative ingestion and sync endpoints.
ADMIN_API_TOKEN=

# Clave compartida independiente para la biblioteca privada
BIBLIOTECA_CLAVE=
